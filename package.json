{
  "name": "pi-code-indexer",
  "version": "0.4.0",
  "description": "AI 驱动的代码知识图谱 — 让 AI 编程助手更快、更准地理解和修改代码",
  "keywords": [
    "pi-package"
  ],
  "license": "MIT",
  "bin": {
    "pi-code-index": "./bin/pi-code-index.js"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && esbuild src/cli.ts --bundle --platform=node --target=node20 --format=esm --packages=external --outfile=dist/cli.mjs",
    "postbuild": "chmod +x dist/cli.mjs",
    "prepare-skill": "npm run build",
    "prepack": "npm run build"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "ignore": "^7.0.5",
    "tree-sitter-wasms": "^0.1.13",
    "web-tree-sitter": "^0.25.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.9.2",
    "esbuild": "^0.28.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RexYoung000/pi-code-index.git"
  },
  "files": [
    "src",
    "bin",
    "dist",
    "skills",
    "README.md",
    "README.zh-CN.md"
  ]
}
